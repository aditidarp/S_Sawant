rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Product images, fabric swatches, and 3D models: public read, admin-only write
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fabrics/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /models/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
